<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activityEnf"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!--  Header  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txt1_activityEnf"
                android:textColor="@color/txt1_activityEnf"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt2_activityEnf"
                android:textSize="26sp" />

        </LinearLayout>

        <!--  Mode Selector Tabs  -->
        <LinearLayout
            android:id="@+id/llModeTabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_prioridad1"
            android:padding="4dp"
            android:layout_marginBottom="36dp">

            <TextView
                android:id="@+id/tabPomodoro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pomodoro\n25 min"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_prioridad1"
                android:tag="pomodoro"/>

            <TextView
                android:id="@+id/tabCorto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Corto\n10 min"
                android:textSize="12sp"
                android:textColor="@color/tab_text_unselected"
                android:background="@android:color/transparent"
                android:tag="corto"/>

            <TextView
                android:id="@+id/tabMini"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mini\n5 min"
                android:textSize="12sp"
                android:textColor="@color/tab_text_unselected"
                android:background="@android:color/transparent"
                android:tag="mini"/>

        </LinearLayout>

        <!--  Timer Circle  -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="36dp">

            <!--  Custom Timer View  -->
            <com.example.mindfocus.TimerCircleView
                android:id="@+id/timerCircleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!--  Timer text content  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvFocusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Enfocado"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19:24"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="minutos"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </FrameLayout>

        <!--  Action Buttons  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnReiniciar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="Reiniciar"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginEnd="12dp" style="@style/Widget.AppCompat.Button.Borderless"
                android:background="@drawable/bg_button_outline"/>

            <Button
                android:id="@+id/btnPausar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="⏸ Pausar"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_primary"
                android:background="@drawable/bg_button_primary"/>

        </LinearLayout>

        <!--  Break Button  -->
        <TextView
            android:id="@+id/btnCambiarDescanso"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☕ Cambiar a descanso (5 min)"
            android:textSize="14sp"
            android:textColor="@color/purple_primary"
            android:background="@drawable/bg_break_button"
            android:layout_marginBottom="28dp"/>

        <!--  Tips Section  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Mientras trabajas:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tips_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="🔕"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Silencia las notificaciones"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="💧"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ten agua cerca"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="🎵"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Música sin letras ayuda"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>