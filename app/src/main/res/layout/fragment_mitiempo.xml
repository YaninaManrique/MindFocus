<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">
            <!-- HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi tiempo"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_semana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semana del 16 al 22 de junio"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="@id/tvTitulo"
                    app:layout_constraintTop_toBottomOf="@id/tvTitulo"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportarPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:text="PDF"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#E53935"
                    app:icon="@drawable/ic_pdf"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FILTROS: dias de la semana -->
            <LinearLayout
                android:id="@+id/layout_dias_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"/>

            <!-- CARDS RESUMEN -->
            <LinearLayout
                android:id="@+id/lvResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total de tareas"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf" />

                    <TextView
                        android:id="@+id/tvTotalTareas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="registradas"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Productividad"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf" />

                    <TextView
                        android:id="@+id/tvProductividad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excelente"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/fondo_blanco"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvCompletadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completadas: 0"/>

                <TextView
                    android:id="@+id/tvPorcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textStyle="bold"
                    android:textSize="24sp"/>

            </LinearLayout>

            <!-- SECCIÓN POR PRIORIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POR PRIORIDAD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_secondary"/>

            <!-- Donut + leyenda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Gráfico de donut (personalView o View placeholder) -->
                <com.diacode.mindfocus.DonutChartView
                    android:id="@+id/donut_chart"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="20dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"/>
            </LinearLayout>

            <!-- SECCIÓN TIPO DE TAREA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DE TAREA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <!-- Lista de materias con barra de progreso -->
            <LinearLayout
                android:id="@+id/ll_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <!-- Item: ESTUDIO-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <!-- INDICADOR DE COLOR -->
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/indicador_circular_estudio" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📚 Estudio"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvEstudioCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6h 20m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barEstudio"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="#E0E0E0">
                        <View
                            android:id="@+id/segEstudioCompletado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4CAF50"/>
                        <View
                            android:id="@+id/segEstudioPendiente"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E53935"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Item: EJERCICIO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <!-- INDICADOR DE COLOR -->
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/indicador_circular_ejercicio" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏃 Ejercicio"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvEjercicioCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3h 55m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/barEjercicio"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="#E0E0E0">
                        <View
                            android:id="@+id/segEjercicioCompletado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4CAF50"/>
                        <View
                            android:id="@+id/segEjercicioPendiente"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E53935"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Item: HOGAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <!-- INDICADOR DE COLOR -->
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/indicador_circular_hogar" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏠 Hogar"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvHogarCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h 35m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/barHogar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="#E0E0E0">
                        <View
                            android:id="@+id/segHogarCompletado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4CAF50"/>
                        <View
                            android:id="@+id/segHogarPendiente"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E53935"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Item: TRABAJO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <!-- INDICADOR DE COLOR -->
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/indicador_circular_trabajo" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💼 Trabajo"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvTrabajoCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h 50m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/barTrabajo"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="#E0E0E0">
                        <View
                            android:id="@+id/segTrabajoCompletado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4CAF50"/>
                        <View
                            android:id="@+id/segTrabajoPendiente"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E53935"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Item: CREATIVO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <!-- INDICADOR DE COLOR -->
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/indicador_circular_creativo" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎨 Creativo"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvCreativoCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h 50m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/barCreativo"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="#E0E0E0">
                        <View
                            android:id="@+id/segCreativoCompletado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4CAF50"/>
                        <View
                            android:id="@+id/segCreativoPendiente"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#E53935"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- SUGERENCIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/fondo_lila"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/tvFrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Llevas poco tiempo en Física II y tienes un examen en 5 días. Considera añadir al menos 2h más esta semana."
                    android:textSize="12sp"
                    android:textColor="@color/purple_dark"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
