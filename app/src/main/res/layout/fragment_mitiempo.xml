<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_primary" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--  Header  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:background="@color/background_primary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi tiempo"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tv_semana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Semana del 16 al 22 de junio"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
        <!--  Divider  -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>
        <!--  Tabs: Hoy / Esta semana / Este mes  -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tab_hoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoy" android:textSize="13sp" android:textColor="@color/text_secondary" android:background="@drawable/bg_tab_inactive" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tab_semana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esta semana" android:textSize="13sp" android:textColor="@color/white" android:background="@drawable/bg_tab_active" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tab_mes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Este mes" android:textSize="13sp" android:textColor="@color/text_secondary" android:background="@drawable/bg_tab_inactive" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </HorizontalScrollView>
        <!--  Tarjetas de resumen  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:weightSum="2">
            <!--  Tarjeta: Total registrado  -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total registrado" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                <TextView android:id="@+id/tv_total_horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="18h 40m" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="esta semana" android:textSize="10sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
            <!--  Tarjeta: Materia más estudiada  -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Más estudiada" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                <TextView android:id="@+id/tv_top_horas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="6h 20m" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tv_top_materia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cálculo III" android:textSize="10sp" android:textColor="@color/text_tertiary"/>
            </LinearLayout>
        </LinearLayout>
        <!--  Sección: Gráfico de dona  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POR MATERIA" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:letterSpacing="0.08" android:paddingHorizontal="20dp" android:paddingBottom="10dp"/>
        <!--  Gráfico de dona (MPAndroidChart)  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="16dp" android:gravity="center_vertical">
            <com.github.mikephil.charting.charts.PieChart android:id="@+id/pieChart" android:layout_width="160dp" android:layout_height="160dp"/>
            <!--  Leyenda personalizada  -->
            <LinearLayout android:id="@+id/ll_leyenda" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:gravity="center_vertical">
                <!--  Se llena dinámicamente desde Java  -->
            </LinearLayout>
        </LinearLayout>
        <!--  Divider  -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:marginHorizontal="16dp" android:background="@color/divider"/>
        <!--  Sección: Barras de detalle  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DETALLE DE ACTIVIDAD" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:letterSpacing="0.08" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="10dp"/>
        <!--  Lista de barras (se llena desde Java)  -->
        <LinearLayout android:id="@+id/ll_barras" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp"/>
        <!--  Tarjeta de insight  -->
        <LinearLayout android:id="@+id/card_insight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:background="@drawable/bg_insight" android:orientation="horizontal" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="18sp" android:layout_marginEnd="10dp" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/tv_insight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Llevas poco tiempo en Física II y tienes un examen en 5 días. Considera añadir al menos 2h más esta semana." android:textSize="13sp" android:lineSpacingExtra="3dp" android:textColor="@color/purple_dark"/>
        </LinearLayout>
        <!--  Espacio inferior para el bottom nav  -->
        <View android:layout_width="match_parent" android:layout_height="80dp"/>
    </LinearLayout>
</ScrollView>