<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi tiempo"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_semana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semana del 16 al 22 de junio"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="@id/tvTitulo"
                    app:layout_constraintTop_toBottomOf="@id/tvTitulo"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportarPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:text="PDF"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#E53935"
                    app:icon="@drawable/ic_pdf"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- TABS -->
            <LinearLayout
                android:id="@+id/llModeTabs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_prioridad1"
                android:padding="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tabPomodoro"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Hoy"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected"
                    android:tag="pomodoro"/>

                <TextView
                    android:id="@+id/tabCorto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Esta semana"
                    android:textSize="12sp"
                    android:textColor="@color/tab_text_unselected"
                    android:background="@android:color/transparent"
                    android:tag="corto"/>

                <TextView
                    android:id="@+id/tabMini"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Este mes"
                    android:textSize="12sp"
                    android:textColor="@color/tab_text_unselected"
                    android:background="@android:color/transparent"
                    android:tag="mini"/>

            </LinearLayout>

            <!-- CARDS RESUMEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total registrado"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf" />

                    <TextView
                        android:id="@+id/tv_total_tiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18h 40m"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="esta semana"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Materia más estudiada"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf" />

                    <TextView
                        android:id="@+id/tv_materia_top_tiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6h 20m"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_materia_top_nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cálculo III"
                        android:textSize="11sp"
                        android:textColor="@color/txt1_activityEnf"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECCIÓN POR MATERIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POR MATERIA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <!-- Donut + leyenda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Gráfico de donut (personalView o View placeholder) -->
                <com.diacode.mindfocus.DonutChartView
                    android:id="@+id/donut_chart"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="20dp" />

                <!-- Leyenda -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- ítem leyenda × 5 (repetir según materias) -->
                    <include layout="@layout/item_leyenda_materia"
                        android:id="@+id/leyenda_calculo" />
                    <include layout="@layout/item_leyenda_materia"
                        android:id="@+id/leyenda_prog" />
                    <include layout="@layout/item_leyenda_materia"
                        android:id="@+id/leyenda_fisica" />
                    <include layout="@layout/item_leyenda_materia"
                        android:id="@+id/leyenda_ingles" />
                    <include layout="@layout/item_leyenda_materia"
                        android:id="@+id/leyenda_otras" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECCIÓN DETALLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALLE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <!-- Lista de materias con barra de progreso -->
            <LinearLayout
                android:id="@+id/ll_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp">

                <!-- Item: Cálculo III -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="∫  Cálculo III"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6h 20m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="77"
                        android:progressDrawable="@drawable/progress_purple"
                        android:max="100" />

                </LinearLayout>

                <!-- Item: Programación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="&lt;/&gt;  Programación"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3h 55m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="48"
                        android:progressDrawable="@drawable/progress_teal"
                        android:max="100" />

                </LinearLayout>

                <!-- Item: Física II -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡  Física II"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h 35m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="31"
                        android:progressDrawable="@drawable/progress_orange"
                        android:max="100" />

                </LinearLayout>

                <!-- Item: Inglés -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="A  Inglés"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h 50m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="22"
                        android:progressDrawable="@drawable/progress_yellow"
                        android:max="100" />

                </LinearLayout>

            </LinearLayout>

            <!-- SUGERENCIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/fondo_lila"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Llevas poco tiempo en Física II y tienes un examen en 5 días. Considera añadir al menos 2h más esta semana."
                    android:textSize="12sp"
                    android:textColor="@color/purple_dark"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
