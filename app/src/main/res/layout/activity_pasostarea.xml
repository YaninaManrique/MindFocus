<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_cream"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- SCROLL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:src="@drawable/ic_back"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_main_tarea"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- CARD PROGRESO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/bg_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_marginTop="0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- CIRCULO -->
                <TextView
                    android:text="33%"
                    android:textColor="@color/text_circle"
                    android:textStyle="bold"
                    android:background="@drawable/ic_count"
                    android:gravity="center"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_steps_complete"
                        android:textColor="@color/text_circle_complete"
                        android:textStyle="bold"
                        android:textSize="20dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_steps_missing"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LISTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_list_steps"
            android:textStyle="bold"
            android:layout_marginTop="14dp"/>


        <!-- ITEM COMPLETADO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/sc_item1"
            app:strokeWidth="2dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:cardBackgroundColor="@color/bg_item">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_item1"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM NORMAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_item">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_item2"
                android:padding="30dp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_item">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/text_item3"
                android:padding="30dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTON -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_text_focus"
            android:backgroundTint="@color/btn_bg_focus"
            android:textColor="@color/btn_text_focus"
            android:layout_marginTop="20dp"/>

        <!-- TIP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_tip"
            android:textColor="@color/text_tip"
            android:layout_marginTop="10dp"
            android:textAlignment="center"/>

    </LinearLayout>


    </ScrollView>

        <!-- ── BOTTOM NAVIGATION ── -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/btn_bg_navigation"
            android:paddingTop="10dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Nav: Inicio -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_op1"
                    android:textSize="12sp"
                    android:textColor="@color/text_inicio"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Nav: Tareas (activo) -->
            <LinearLayout
                android:id="@+id/nav_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tasks" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_op2"
                    android:textSize="12sp"
                    android:textColor="@color/nav_op2"
                    android:layout_marginTop="2dp"/>
                <!-- Indicador activo -->
                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"
                    android:background="@drawable/fondo_activo"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- Nav: Enfoque -->
            <LinearLayout
                android:id="@+id/nav_focus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_op3"
                    android:textSize="12sp"
                    android:textColor="@color/nav_op3"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Nav: Logros -->
            <LinearLayout
                android:id="@+id/nav_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_op4"
                    android:textSize="12sp"
                    android:textColor="@color/nav_op4"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



