<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activityTar">

    <!-- SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:src="@drawable/ic_back"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:id="@+id/tvNombreTarea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- BANNER SOLO LECTURA -->
                <LinearLayout
                    android:id="@+id/layout_bloqueado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_lila"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔒 Este día ya pasó. Solo puedes ver el estado, no editar."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_dark"/>

                </LinearLayout>

                <!-- CARD PROGRESO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/bg_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:layout_marginTop="0dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- CIRCULO -->
                        <TextView
                            android:id="@+id/tvCantidad"
                            android:text="@string/text_cir"
                            android:textColor="@color/text_circle"
                            android:textStyle="bold"
                            android:background="@drawable/ic_count"
                            android:gravity="center"
                            android:layout_width="60dp"
                            android:layout_height="60dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvCompletados"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_steps_complete"
                                android:textColor="@color/text_circle_complete"
                                android:textStyle="bold"
                                android:textSize="20sp"/>

                            <TextView
                                android:id="@+id/tvFaltantes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_steps_missing"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            <!-- TIMER DE LA TAREA -->
            <LinearLayout
                android:id="@+id/layout_timer_tarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp">
                <TextView
                    android:id="@+id/tvTimerTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarTarea"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:text="▶ Iniciar"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFinalizarTarea"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:text="⏹ Finalizar"
                        android:textAllCaps="false"
                        android:enabled="false"/>
                </LinearLayout>
            </LinearLayout>

                <!-- LISTA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_list_steps"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPasos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- TIP -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_tip"
                    android:textColor="@color/text_tip"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"/>
        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>



