<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_new_task">

    <!-- SCROLL PRINCIPAL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!--  HEADER: flecha + título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="45dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Botón volver -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/background_card_task"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volver"
                        android:src="@drawable/ic_back"
                        app:tint="@color/color_tint" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/text_header"
                    android:textColor="@color/color_tint"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TARJETA 1: Tipo de tarea -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/background_tar1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Etiqueta sección -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_type_task"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_type_task"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>

                    <!-- Fila 1: Estudio + Ejercicio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <!-- Chip: Estudio (activo) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/chip_study"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/background_card_study"
                            app:strokeColor="@color/stroke_color_study"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_study_img"
                                    android:textSize="13sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_study"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_study_color"/>
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Chip: Ejercicio (inactivo) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/chip_exercise"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/background_exercise"
                            app:strokeColor="@color/stroke_color_exercise"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_exercise_img"
                                    android:textSize="13sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_exercise"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_exercise_color"/>
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Fila 2: Hogar + Trabajo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/chip_home"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/card_background_home"
                            app:strokeColor="@color/stroke_color_home"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="13sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Hogar" android:textSize="12sp" android:textStyle="bold" android:textColor="#6B6B6B"/>
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/chip_work"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/card_background_work"
                            app:strokeColor="@color/stroke_color_work"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💼" android:textSize="13sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Trabajo" android:textSize="12sp" android:textStyle="bold" android:textColor="#6B6B6B"/>
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Fila 3: Creativo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/chip_creative"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/card_background_creative"
                            app:strokeColor="@color/stroke_color_creative"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎨" android:textSize="13sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Creativo" android:textSize="12sp" android:textStyle="bold" android:textColor="#6B6B6B"/>
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 2: Nombre de la tarea -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/background_tar2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_name_task"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_name_task"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp"/>

                    <!-- Input con borde verde -->
                    <EditText
                        android:id="@+id/et_task_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/text_task"
                        android:textSize="14sp"
                        android:textColor="@color/text_task"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/fondo_activo"
                        android:inputType="text"
                        android:singleLine="true"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 3: Nivel de urgencia -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/background_tar3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_urgency"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_urgency"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>

                    <!-- Tres opciones de prioridad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- Normal -->
                        <LinearLayout
                            android:id="@+id/priority_normal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_prioridad1">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/ic_greencircle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_prioridad1"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_prioridad1"
                                android:layout_marginTop="6dp"/>

                        </LinearLayout>

                        <!-- Media (activo) -->
                        <LinearLayout
                            android:id="@+id/priority_media"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_prioridad1">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/ic_yellowcircle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_prioridad2"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_prioridad2"
                                android:layout_marginTop="6dp"/>

                        </LinearLayout>

                        <!-- Alta -->
                        <LinearLayout
                            android:id="@+id/priority_alta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@drawable/bg_prioridad1">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/ic_redpoint"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_prioridad3"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_prioridad3"
                                android:layout_marginTop="6dp"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- pasos de la tarea -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/background_tar4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASOS DE LA TAREA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#6B6B6B"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>
                    <!-- Aquí se agregarán dinámicamente los item_step.xml -->
                    <LinearLayout
                        android:id="@+id/layout_steps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                    <!-- Botón Agregar paso -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_step"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="+ Agregar paso"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:backgroundTint="@color/btn_guardar_background"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!--  TARJETA 4: Nota rápida -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/background_tar4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_opcional"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#6B6B6B"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp"/>

                    <!-- Input vacío / placeholder -->
                    <EditText
                        android:id="@+id/et_note"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Ej: Capítulos 3 y 4…"
                        android:textSize="13sp"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_color_opcional"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/fondo_blanco"
                        android:inputType="textMultiLine"
                        android:maxLines="3"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN GUARDAR (fijo abajo) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/btn_guardar_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_guardar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/btn_guardar"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>